{
  "name": "@yorisoi-console/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app of the channel management system (ADR-001)",
  "scripts": {
    "synth": "cdk synth --quiet",
    "cdk": "cdk",
    "synth:relay": "cdk synth -a \"npx tsx bin/relay.ts\" --quiet",
    "synth:tiles": "cdk synth -a \"npx tsx bin/tiles.ts\" --quiet",
    "synth:studio": "cdk synth -a \"npx tsx bin/studio.ts\" --quiet",
    "diagrams": "node tools/diagrams.mjs"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "aws-cdk": "^2.1144.0",
    "cdk-dia": "^0.12.4",
    "esbuild": "^0.28.2"
  }
}
